{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://demo-story.redhat-intel.com/virtualization-ai-501/qualification-response.schema.json", "title": "Multi-VM inference fleet qualification response", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "decision", "reason", "source_state", "reason_codes", "policy", "authority", "qualification", "evidence"],
  "properties": {"schema_version": {"const": "demo-story.redhat-intel.com/virtualization-ai-501/qualification-response/v1"}, "request_id": {"type": "string"}, "decision": {"enum": ["ALLOW_REVIEW", "REFUSE", "ABSTAIN"]}, "reason": {"type": "string"}, "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "policy": {"type": "object"}, "authority": {"type": "object", "additionalProperties": false, "required": ["human_promotion_required", "promotion_performed", "certification_performed", "llm_authority"], "properties": {"human_promotion_required": {"const": true}, "promotion_performed": {"const": false}, "certification_performed": {"const": false}, "llm_authority": {"const": "NONE"}}}, "qualification": {"type": "object", "additionalProperties": false, "required": ["status", "fleet_size", "trial_results", "envelope"], "properties": {"status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}, "fleet_size": {"type": "integer", "minimum": 3}, "trial_results": {"type": "array", "minItems": 3}, "envelope": {"type": "object"}}}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-record.schema.json"}}}
}
