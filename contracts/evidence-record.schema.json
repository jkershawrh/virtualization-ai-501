{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://demo-story.redhat-intel.com/virtualization-ai-501/evidence-record.schema.json", "title": "Fleet qualification evidence", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "request_id", "state", "kind", "source", "source_state", "observed_at", "freshness", "digest", "payload"],
  "properties": {"schema_version": {"const": "demo-story.redhat-intel.com/virtualization-ai-501/evidence/v1"}, "evidence_id": {"type": "string", "minLength": 8}, "request_id": {"type": "string", "minLength": 8}, "state": {"enum": ["DISCOVER", "BASELINE", "MIGRATE", "DISRUPT", "CORRELATE", "QUALIFY", "HANDOFF"]}, "kind": {"enum": ["OPENSHIFT", "KUBEVIRT", "VM", "MIGRATION", "DISRUPTION", "CPU_PLACEMENT", "INFERENCE", "TELEMETRY", "CONTINUITY", "DECISION"]}, "source": {"type": "string", "minLength": 1}, "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]}, "observed_at": {"type": "string", "format": "date-time"}, "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "payload": {"type": "object"}}
}
