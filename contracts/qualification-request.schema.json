{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://demo-story.redhat-intel.com/virtualization-ai-501/qualification-request.schema.json", "title": "Multi-VM inference fleet qualification request", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "requested_by", "fleet", "envelope", "trials", "evidence_snapshot"],
  "properties": {
    "schema_version": {"const": "demo-story.redhat-intel.com/virtualization-ai-501/qualification-request/v1"}, "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,127}$"}, "requested_by": {"type": "string", "minLength": 1},
    "fleet": {"type": "object", "additionalProperties": false, "required": ["namespace", "inference_service", "virtual_machines"], "properties": {"namespace": {"type": "string", "minLength": 1}, "inference_service": {"type": "string", "minLength": 1}, "virtual_machines": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "node", "architecture", "cpu_vendor"], "properties": {"name": {"type": "string", "minLength": 1}, "node": {"type": "string", "minLength": 1}, "architecture": {"const": "amd64"}, "cpu_vendor": {"type": "string", "minLength": 1}}}}}},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["max_p95_ms", "min_success_rate", "max_concurrency", "max_cpu_saturation_pct"], "properties": {"max_p95_ms": {"type": "number", "exclusiveMinimum": 0}, "min_success_rate": {"type": "number", "minimum": 0, "maximum": 1}, "max_concurrency": {"type": "integer", "minimum": 1}, "max_cpu_saturation_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}}},
    "trials": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "concurrency", "requests", "success_rate", "p95_ms", "cpu_saturation_pct", "containment_breaches", "correlation_complete", "state_continuity"], "properties": {"kind": {"enum": ["BASELINE", "MIGRATION", "DISRUPTION"]}, "concurrency": {"type": "integer", "minimum": 1}, "requests": {"type": "integer", "minimum": 1}, "success_rate": {"type": "number", "minimum": 0, "maximum": 1}, "p95_ms": {"type": "number", "minimum": 0}, "cpu_saturation_pct": {"type": "number", "minimum": 0, "maximum": 100}, "containment_breaches": {"type": "integer", "minimum": 0}, "correlation_complete": {"type": "boolean"}, "state_continuity": {"type": "boolean"}}}},
    "evidence_snapshot": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-record.schema.json"}}
  }
}
